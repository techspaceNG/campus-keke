{
  "name": "campus-keke",
  "version": "1.0.0",
  "description": "Campus Keke Ticket Management System - Next.js, Express, Prisma, PostgreSQL",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "cd backend && npx prisma generate",
    "build": "npm run --prefix backend build && npm run --prefix frontend build",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm run test --prefix backend",
    "db:seed": "npm run prisma:seed --prefix backend",
    "db:push": "npm run prisma:push --prefix backend"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "campus-transit",
    "keke",
    "tricycle",
    "ticket-management",
    "qr-code",
    "nextjs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Campus Transit Engineering",
  "license": "ISC"
}
